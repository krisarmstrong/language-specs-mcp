# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ SpecForge MCP - .gitignore                                                ║
# ╠═══════════════════════════════════════════════════════════════════════════╣
# ║ MCP server and Claude Code plugin for authoritative language specs        ║
# ║ Stack: Node.js/TypeScript, Python, MCP, Claude integration               ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ─── Node.js Dependencies ────────────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ─── Build Outputs ───────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ─── Environment & Secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ─── Documentation Build ─────────────────────────────────────────────────────
docs/site/health.json
docs/site/build/
/site

# ─── Web UI (if present) ─────────────────────────────────────────────────────
webui/.next/
webui/node_modules/
webui/dist/
webui/.turbo/

# ─── Testing ─────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/

# ─── Cache & Temporary ───────────────────────────────────────────────────────
.cache/
.turbo/
*.tmp
*.temp
*~

# ─── Important: Keep Specs ───────────────────────────────────────────────────
# Don't ignore specs/ - they're the core value of this project
!specs/
